{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      "src/renderer/src/components/ai-elements/**",
      "src/renderer/src/components/ui/**",
      "src/renderer/src/hooks/use-mobile.ts"
    ],
    "overrides": [
      {
        "files": ["package.json"],
        "rules": ["deslop/unused-dependency"]
      }
    ]
  },
  "share": false,
  "supplyChain": {
    "enabled": false
  }
}
